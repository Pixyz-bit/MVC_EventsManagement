@using System.Globalization
@model MVC_QCUEventsManagement.ViewModels.Admin.EventAnalyticsViewModel
@{
    var q = Model.Query; var culture = CultureInfo.InvariantCulture;
    string[] palette = ["#155bb1", "#287b87", "#85713e", "#5268a6", "#945d76", "#7d8c9a"];
    var circumference = 2 * Math.PI * 74;
}
<section aria-labelledby="demographics-heading" class="mt-6 rounded-xl border border-campus-line bg-white p-5" data-demographics>
    <div class="flex flex-wrap items-start justify-between gap-4"><div><h2 id="demographics-heading" class="text-sm font-bold text-campus-navy">Target demographics</h2><p class="mt-1 text-xs text-campus-muted">Active reservations only · @Model.Reserved students</p></div>
        <form asp-route="AdminEventAnalytics" asp-route-id="@Model.Event.Id" method="get" class="flex items-end gap-2" data-demographic-form>
            <input type="hidden" name="from" value="@q.From" /><input type="hidden" name="interval" value="@q.Interval" /><input type="hidden" name="arrivalPage" value="@q.ArrivalPage" /><input type="hidden" name="cohort" value="@q.Cohort" /><input type="hidden" name="q" value="@q.Q" /><input type="hidden" name="college" value="@q.College" /><input type="hidden" name="program" value="@q.Program" /><input type="hidden" name="page" value="@q.Page" />
            <div><label for="demographic-dimension" class="event-label">Group by</label><select id="demographic-dimension" name="dimension" class="event-input" data-demographic-select>@foreach (var dimension in new[] { "Program", "College", "Year level", "Campus" }) { <option selected="@(q.Dimension == dimension)">@dimension</option> }</select></div><button type="submit" class="event-secondary" data-demographic-apply>Apply</button>
        </form>
    </div>
    @foreach (var dimension in new[] { "Program", "College", "Year level", "Campus" })
    {
        var groups = Model.Distributions[dimension]; var offset = 0d;
        <div data-demographic-panel="@dimension" hidden="@(q.Dimension != dimension)" class="mt-5">
            <div>
                <div class="analytics-donut">
                    <svg viewBox="0 0 200 200" role="img" aria-label="@dimension distribution of @Model.Reserved active reservations" class="block w-full"><circle cx="100" cy="100" r="74" fill="none" stroke="var(--color-campus-line)" stroke-width="30" />
                        @for (var i = 0; i < groups.Count; i++)
                        {
                            var group = groups[i]; var length = Model.Reserved == 0 ? 0 : circumference * group.Reserved / Model.Reserved;
                            var label = $"{group.Label}: {group.Reserved} students ({(Model.Reserved == 0 ? 0 : 100d * group.Reserved / Model.Reserved).ToString("0.0", culture)}%)";
                            <circle data-demographic-slice="@i" data-chart-label="@label" tabindex="0" role="img" aria-label="@label" class="analytics-donut-slice" cx="100" cy="100" r="74" fill="none" stroke="@palette[i % palette.Length]" stroke-width="30" stroke-dasharray="@length.ToString("0.######", culture) @circumference.ToString("0.######", culture)" stroke-dashoffset="@((-offset).ToString("0.######", culture))" transform="rotate(-90 100 100)"><title>@label</title></circle>
                            offset += length;
                        }
                    </svg>
                    <div class="analytics-donut-center"><strong class="text-3xl font-extrabold tabular-nums">@Model.Reserved</strong><span class="mt-1 text-xs text-campus-muted">Registered</span></div>
                </div>
                @if (groups.Count == 0) { <p class="mt-4 text-center text-sm text-campus-muted">No demographic cohorts registered yet.</p> }
                else
                {
                    <ul class="sr-only" aria-label="@dimension counts">@foreach (var group in groups) { <li>@group.Label: @group.Reserved students (@((100d * group.Reserved / Model.Reserved).ToString("0.0", culture))%)</li> }</ul>
                }
            </div>
        </div>
    }
</section>
