@using System.Globalization
@model MVC_QCUEventsManagement.ViewModels.Admin.EventAnalyticsViewModel
@{
    var groups = Model.Distributions["College"].OrderByDescending(g => g.Turnout).ThenByDescending(g => g.Attended).ThenBy(g => g.Label).ToList();
    var max = Math.Max(1, groups.Select(g => Math.Max(g.Attended, g.Reserved - g.Attended)).DefaultIfEmpty(0).Max());
    string Width(int count) => (100d * count / max).ToString("0.##", CultureInfo.InvariantCulture) + "%";
}
<section aria-labelledby="audit-heading" class="mt-6 rounded-xl border border-campus-line bg-white p-5">
    <div class="flex flex-wrap items-start justify-between gap-3"><div><h2 id="audit-heading" class="text-sm font-bold text-campus-navy">Attendance by college</h2><p class="mt-1 text-xs text-campus-muted">Ranked by turnout, then checked-in count</p></div><div class="flex flex-wrap gap-3 text-xs text-campus-muted"><span class="flex items-center gap-2"><span class="size-2 rounded-sm bg-campus-action"></span>Checked in</span><span class="flex items-center gap-2"><span class="size-2 rounded-sm bg-blue-200"></span>@(Model.Event.Status == "Completed" ? "Did not attend" : "Unscanned")</span></div></div>
    @if (groups.Count == 0) { <p class="py-10 text-center text-sm text-campus-muted">No college attendance to compare yet.</p> }
    <div class="mt-5 space-y-5">
        @foreach (var group in groups)
        {
            <div class="grid grid-cols-[minmax(0,1fr)_4rem] items-center gap-x-4 gap-y-2 sm:grid-cols-[minmax(8rem,1fr)_minmax(0,2fr)_4rem]">
                <h3 class="col-span-2 text-xs font-medium wrap-break-word sm:col-span-1">@group.Label</h3>
                <div class="space-y-1.5" role="img" aria-label="@group.Label: @group.Attended checked in, @(group.Reserved - group.Attended) unscanned, @group.Reserved reserved"><div class="flex items-center gap-2"><div class="min-w-0 flex-1"><div class="h-2 rounded-r-sm bg-campus-action" style="width:@Width(group.Attended)"></div></div><span class="w-6 text-right text-xs tabular-nums">@group.Attended</span></div><div class="flex items-center gap-2"><div class="min-w-0 flex-1"><div class="h-2 rounded-r-sm bg-blue-200" style="width:@Width(group.Reserved - group.Attended)"></div></div><span class="w-6 text-right text-xs tabular-nums">@(group.Reserved - group.Attended)</span></div></div>
                <p class="text-right text-xs font-semibold tabular-nums">@group.Turnout.ToString("0.0", CultureInfo.InvariantCulture)%<span class="mt-1 block font-normal text-campus-muted">turnout</span></p>
            </div>
        }
    </div>
</section>
