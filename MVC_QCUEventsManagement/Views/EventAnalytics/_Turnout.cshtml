@using System.Globalization
@model MVC_QCUEventsManagement.ViewModels.Admin.EventAnalyticsViewModel
@{
    string Percent(double value) => value.ToString("0.0", CultureInfo.InvariantCulture) + "%";
    string Width(double value) => Math.Clamp(value, 0, 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    var ended = Model.Event.Status == "Completed";
    var status = Model.Event.Status == "Cancelled" ? "Event cancelled" : ended ? "Final attendance" : Model.Reserved == 0 ? "Awaiting registrations" : Model.Attended == 0 ? "Awaiting check-ins" : "Check-in in progress";
}
<section aria-labelledby="turnout-heading" class="min-w-0 rounded-xl border border-campus-line bg-white p-5">
    <h2 id="turnout-heading" class="text-sm font-bold text-campus-navy">Attendance turnout</h2>
    <p class="mt-1 text-xs text-campus-muted">Active reservations only</p>
    <div class="mt-5 flex items-center justify-between gap-4"><span class="text-sm font-semibold">Rate</span><strong class="text-3xl font-extrabold tabular-nums text-campus-action">@Percent(Model.Turnout)</strong></div>
    <div class="mt-3 h-2 overflow-hidden rounded-full bg-campus-input" role="progressbar" aria-label="Attendance turnout" aria-valuenow="@Math.Clamp(Model.Turnout, 0, 100).ToString("0.##", CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100"><div class="h-full bg-campus-action" style="width:@Width(Model.Turnout)"></div></div>
    <dl class="mt-5 space-y-3 text-sm">
        <div class="flex justify-between gap-3"><dt class="flex items-center gap-2 text-campus-muted"><span aria-hidden="true" class="size-2 rounded-full bg-campus-muted"></span>Registered</dt><dd class="font-semibold tabular-nums">@Model.Reserved</dd></div>
        <div class="flex justify-between gap-3"><dt class="flex items-center gap-2 text-campus-muted"><span aria-hidden="true" class="size-2 rounded-full bg-campus-action"></span>Checked in</dt><dd class="font-semibold tabular-nums">@Model.Attended</dd></div>
        <div class="flex justify-between gap-3"><dt class="flex items-center gap-2 text-campus-muted"><span aria-hidden="true" class="size-2 rounded-full bg-rose-600"></span>@(ended ? "Did not attend" : "Unscanned")</dt><dd class="font-semibold tabular-nums">@Model.Unscanned <span class="text-xs font-normal text-campus-muted">(@Percent(Model.Reserved == 0 ? 0 : 100d * Model.Unscanned / Model.Reserved))</span></dd></div>
    </dl>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-campus-line pt-4 text-xs"><span class="text-campus-muted">Status</span><span class="rounded-md bg-blue-50 px-2.5 py-1.5 font-semibold text-campus-action">@status</span></div>
    <div class="mt-5 space-y-4 border-t border-campus-line pt-4">
        <div><div class="flex flex-wrap justify-between gap-2 text-xs"><span>Booking fill</span><strong class="tabular-nums">@Model.Event.Registered / @Model.Event.Capacity · @Percent(Model.BookingFill)</strong></div><div class="mt-2 h-1.5 overflow-hidden rounded-full bg-campus-input"><div class="h-full bg-campus-action" style="width:@Width(Model.BookingFill)"></div></div></div>
        <div><div class="flex flex-wrap justify-between gap-2 text-xs"><span>Attendance / capacity</span><strong class="tabular-nums">@Model.Attended / @Model.Event.Capacity · @Percent(Model.Occupancy)</strong></div><div class="mt-2 h-1.5 overflow-hidden rounded-full bg-campus-input"><div class="h-full bg-campus-action" style="width:@Width(Model.Occupancy)"></div></div></div>
    </div>
</section>
