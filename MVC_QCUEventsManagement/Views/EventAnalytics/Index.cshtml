@using System.Globalization
@using MVC_QCUEventsManagement.ViewModels.Admin
@model EventAnalyticsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Analytics · {Model.Event.Title}";
    var ev = Model.Event; var q = Model.Query; var history = q.From == "history";
    ViewData["AdminSection"] = history ? "History" : "Events";
    var culture = CultureInfo.InvariantCulture;
    string Percent(double value) => value.ToString("0.0", culture) + "%";
    Dictionary<string, string> Routes(int? page = null, int? arrivalPage = null, string? cohort = null) => new() {
        ["id"] = ev.Id.ToString(culture), ["interval"] = q.Interval.ToString(culture), ["arrivalPage"] = (arrivalPage ?? q.ArrivalPage).ToString(culture),
        ["dimension"] = q.Dimension, ["cohort"] = cohort ?? q.Cohort!, ["q"] = q.Q ?? "", ["college"] = q.College ?? "", ["program"] = q.Program ?? "",
        ["page"] = (page ?? q.Page).ToString(culture), ["from"] = q.From ?? "" };
    var columns = "xl:grid-cols-[8.5rem_minmax(0,1fr)_minmax(0,1.1fr)_7rem_6rem]";
}
<main id="event-analytics" class="w-full px-4 pt-6 pb-8 sm:px-6 sm:pt-7 lg:px-8">
    <a asp-route="@(history ? "AdminEventHistory" : "AdminEvents")" class="mb-5 inline-flex min-h-11 items-center gap-2 rounded-lg text-sm font-semibold text-campus-muted hover:text-campus-action"><span aria-hidden="true">←</span> @(history ? "Back to history" : "Back to events")</a>
    <partial name="_EventHeader" model="@(new EventHeaderViewModel(ev.Title, ev.Status, ev.StartsAt, ev.EndsAt, ev.Venue, ev.Registered, ev.Capacity))" />
    <partial name="_EventWorkflowNavigation" model="@(new EventWorkflowViewModel(ev.Id, "Analytics", history))" />
    <section aria-labelledby="analytics-overview" class="mt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2"><h2 id="analytics-overview" class="text-base font-bold text-campus-navy">Attendance overview</h2><p class="text-xs text-campus-muted">Current records · Reload to refresh</p></div>
        <dl class="mt-4 grid grid-cols-2 gap-y-5 border-y border-campus-line py-5 lg:grid-cols-4">
            <div class="pr-4"><dt class="text-xs text-campus-muted">Active reservations</dt><dd class="mt-1 text-2xl font-bold tabular-nums">@Model.Reserved<span class="mt-1 block text-xs font-normal text-campus-muted">Present + unscanned</span></dd></div>
            <div class="border-l border-campus-line px-4"><dt class="text-xs text-campus-muted">Checked in</dt><dd class="mt-1 text-2xl font-bold tabular-nums">@Model.Attended<span class="mt-1 block text-xs font-normal text-campus-muted">@Percent(Model.Turnout) turnout</span></dd></div>
            <div class="pr-4 lg:border-l lg:border-campus-line lg:px-4"><dt class="text-xs text-campus-muted">Unscanned reservations</dt><dd class="mt-1 text-2xl font-bold tabular-nums">@Model.Unscanned<span class="mt-1 block text-xs font-normal text-campus-muted">Not checked in</span></dd></div>
            <div class="border-l border-campus-line px-4"><dt class="text-xs text-campus-muted">Cancelled passes</dt><dd class="mt-1 text-2xl font-bold tabular-nums">@Model.Cancelled<span class="mt-1 block text-xs font-normal text-campus-muted">@Percent(Model.Attrition) of all passes</span></dd></div>
        </dl>
    </section>
    <div class="mt-6 grid items-stretch gap-5 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
        <partial name="_Arrivals" model="Model" />
        <partial name="_Turnout" model="Model" />
    </div>
    <partial name="_Demographics" model="Model" />
    <section aria-labelledby="cohort-heading" class="mt-8 overflow-hidden rounded-xl border border-campus-line">
        <h2 id="cohort-heading" class="p-4 text-sm font-bold text-campus-navy">Student cohorts</h2>
        <nav aria-label="Analytics cohorts" class="flex flex-wrap gap-x-5 border-y border-campus-line px-4 text-sm">@foreach (var cohort in new[] { ("Present", "Checked in", Model.Attended), ("NoShow", "Unscanned", Model.Unscanned), ("Cancelled", "Cancelled", Model.Cancelled), ("Reserved", "All active", Model.Reserved) }) { <a asp-route="AdminEventAnalytics" asp-all-route-data="@Routes(page: 1, cohort: cohort.Item1)" aria-current="@(q.Cohort == cohort.Item1 ? "page" : null)" class="inline-flex min-h-12 items-center gap-2 border-b-2 @(q.Cohort == cohort.Item1 ? "border-campus-action font-semibold text-campus-action" : "border-transparent text-campus-muted")">@cohort.Item2<span class="rounded-md bg-campus-input px-1.5 py-0.5 text-xs tabular-nums">@cohort.Item3</span></a> }</nav>
        <form asp-route="AdminEventAnalytics" asp-route-id="@ev.Id" method="get" role="search" class="grid items-end gap-3 p-4 xl:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)_minmax(0,.8fr)_auto]">
            <input type="hidden" name="dimension" value="@q.Dimension" /><input type="hidden" name="from" value="@q.From" /><input type="hidden" name="interval" value="@q.Interval" /><input type="hidden" name="arrivalPage" value="@q.ArrivalPage" /><input type="hidden" name="cohort" value="@q.Cohort" />
            <div class="min-w-0"><label for="analytics-search" class="event-label">Search cohort</label><input id="analytics-search" type="search" name="q" value="@q.Q" maxlength="150" placeholder="Student ID, name or ticket reference" class="event-input" /></div>
            <div class="min-w-0"><label for="analytics-college" class="event-label">College</label><select id="analytics-college" name="college" class="event-input"><option value="">All colleges</option>@if (q.College is not null && !Model.Colleges.Contains(q.College)) { <option selected>@q.College</option> }@foreach (var college in Model.Colleges) { <option selected="@(q.College == college)">@college</option> }</select></div>
            <div class="min-w-0"><label for="analytics-program" class="event-label">Program</label><select id="analytics-program" name="program" class="event-input"><option value="">All programs</option>@if (q.Program is not null && !Model.Programs.Contains(q.Program)) { <option selected>@q.Program</option> }@foreach (var program in Model.Programs) { <option selected="@(q.Program == program)">@program</option> }</select></div>
            <div class="flex flex-wrap gap-2"><button type="submit" class="event-primary">Search</button><a asp-route="AdminEventAnalytics" asp-route-id="@ev.Id" asp-route-from="@q.From" asp-route-interval="@q.Interval" asp-route-dimension="@q.Dimension" asp-route-cohort="@q.Cohort" class="event-secondary">Reset filters</a></div>
        </form>
        <div aria-hidden="true" class="@columns hidden gap-x-4 border-y border-campus-line bg-campus-input px-4 py-3 text-xs font-semibold text-campus-muted xl:grid"><span>Ticket ref</span><span>Student</span><span>College & program</span><span>Year & section</span><span>Status</span></div>
        <ul role="list" class="divide-y divide-campus-line">@foreach (var row in Model.CohortRows) { <li class="@columns grid gap-4 px-4 py-5 text-sm sm:grid-cols-2 xl:items-center"><div class="min-w-0"><span class="mb-1 block text-xs text-campus-muted xl:sr-only">Ticket ref</span><span class="text-xs wrap-break-word tabular-nums">@row.TicketReference(ev.Id)</span></div><div class="min-w-0"><h3 class="font-semibold wrap-break-word">@row.Name</h3><p class="mt-1 text-xs wrap-break-word text-campus-muted">@row.StudentId</p></div><div class="min-w-0"><p class="font-semibold wrap-break-word">@row.Program</p><p class="mt-1 text-xs wrap-break-word text-campus-muted">@row.College</p></div><div><p>Year @row.Year</p><p class="mt-1 text-xs text-campus-muted">@row.Section</p></div><div><span class="rounded-full bg-campus-input px-2.5 py-1 text-xs font-semibold">@(row.Status == "NoShow" ? "Reserved" : row.Status)</span></div></li> }</ul>
        @if (Model.Total == 0) { <p class="px-4 py-10 text-center text-sm text-campus-muted">No students in this cohort match the current filters.</p> }
        <nav aria-label="Cohort pages" class="flex flex-wrap items-center justify-between gap-3 border-t border-campus-line px-4 py-3 text-xs text-campus-muted"><span>@Model.Total matching · Page @q.Page of @Model.TotalPages</span><div class="flex gap-2">@if (q.Page > 1) { <a asp-route="AdminEventAnalytics" asp-all-route-data="@Routes(page: q.Page - 1)" class="event-secondary">Previous</a> }@if (q.Page < Model.TotalPages) { <a asp-route="AdminEventAnalytics" asp-all-route-data="@Routes(page: q.Page + 1)" class="event-secondary">Next</a> }</div></nav>
    </section>
</main>

@section Scripts {
    <script src="~/js/admin/event-analytics.js" asp-append-version="true" defer></script>
}
