@using System.Globalization
@using MVC_QCUEventsManagement.ViewModels.Admin
@model EventDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Event.Title;
    var fromHistory = ViewData["FromHistory"] is true;
    ViewData["AdminSection"] = fromHistory ? "History" : "Events";
    var ev = Model.Event;
    var status = ev.Status == "Upcoming" && !Model.CanManage ? "Completed" : ev.Status;
    var token = Convert.ToBase64String(ev.Version);
    var focus = "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-campus-focus";
    string Date(DateOnly date) => date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
}
<main class="w-full px-4 pt-6 pb-8 sm:px-6 sm:pt-7 lg:px-8">
    <a asp-route="@(fromHistory ? "AdminEventHistory" : "AdminEvents")" class="@focus mb-5 inline-flex min-h-11 items-center gap-2 rounded-lg text-sm font-semibold text-campus-muted hover:text-campus-action"><span aria-hidden="true">←</span> @(fromHistory ? "Back to history" : "Back to events")</a>
    <partial name="_EventHeader" model="@(new EventHeaderViewModel(ev.Title, status, ev.Start, ev.End, ev.Venue, ev.Registered, ev.Capacity, Model.CanManage && !Model.Editing ? ev.Id : null))" />
    <partial name="_EventWorkflowNavigation" model="@(new EventWorkflowViewModel(ev.Id, "Details", fromHistory))" />
    @if (TempData["EventMessage"] is string message)
    {
        <p role="status" class="mt-5 rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">@message</p>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div role="alert" class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800"><div asp-validation-summary="All"></div></div>
    }
    @if (ev.Status == "Cancelled")
    {
        <section class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4" aria-label="Cancellation details"><h2 class="text-sm font-bold text-red-900">Event cancelled</h2><p class="mt-1 text-sm whitespace-pre-wrap wrap-break-word text-red-800">@ev.CancellationReason</p></section>
    }

    @if (Model.Editing)
    {
        <form asp-action="Edit" asp-route-id="@ev.Id" method="post" enctype="multipart/form-data" class="mt-6" id="event-edit-form">
            <input type="hidden" name="version" value="@(ViewData["EditVersion"] as string ?? token)" />
            <input type="hidden" asp-for="Input.Confirm" value="true" />
            <div class="grid gap-5 lg:grid-cols-12">
                <section class="event-edit-section lg:col-span-7" aria-labelledby="edit-information"><h2 id="edit-information" class="event-edit-heading">Event information</h2>
                    <div><label asp-for="Input.Title" class="event-label">Event title *</label><input asp-for="Input.Title" class="event-input" required maxlength="200" /><span asp-validation-for="Input.Title" class="event-error"></span></div>
                    <div><label asp-for="Input.Description" class="event-label">Description (Optional)</label><textarea asp-for="Input.Description" class="event-input" rows="4" maxlength="10000"></textarea></div>
                </section>
                <section class="event-edit-section lg:col-span-5" aria-labelledby="edit-banner"><h2 id="edit-banner" class="event-edit-heading">Promotional banner</h2>
                    @if (ev.Banner is not null) { <img src="/admin/events/@ev.Id/banner" alt="Current event banner" class="max-h-48 w-full rounded-lg object-contain" /> }
                    else { <p class="text-sm text-campus-muted">No banner uploaded.</p> }
                    <div><label asp-for="Input.Banner" class="event-label">Replace banner (Optional)</label><input asp-for="Input.Banner" type="file" accept="image/png,image/jpeg,image/webp" class="event-input" /><p class="event-hint">PNG, JPG or WEBP · Up to 5 MB</p><span asp-validation-for="Input.Banner" class="event-error"></span><img id="edit-banner-preview" alt="Selected replacement banner" class="mt-3 hidden max-h-48 max-w-full rounded-lg object-contain" /></div>
                    @if (ev.Banner is not null) { <label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="removeBanner" value="true" /> Remove current banner</label> }
                </section>
                <section class="event-edit-section lg:col-span-4" aria-labelledby="edit-location"><h2 id="edit-location" class="event-edit-heading">Venue & seating</h2>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
                        <div><label asp-for="Input.VenueLocation" class="event-label">Venue *</label><input asp-for="Input.VenueLocation" class="event-input" required maxlength="200" /></div>
                        <div><label asp-for="Input.MaxCapacity" class="event-label">Capacity *</label><input asp-for="Input.MaxCapacity" class="event-input" required min="@Math.Max(1, ev.Registered)" max="2147483647" /><p class="event-hint">@ev.Registered registered</p></div>
                    </div>
                </section>
                <section class="event-edit-section lg:col-span-4" aria-labelledby="edit-schedule"><h2 id="edit-schedule" class="event-edit-heading">Event schedule</h2>
                    <div><label asp-for="Input.EventDate" class="event-label">Event date *</label><input asp-for="Input.EventDate" type="date" class="event-input" required min="1753-01-01" max="9998-12-31" /></div>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"><div><label asp-for="Input.StartTime" class="event-label">Starts at *</label><input asp-for="Input.StartTime" type="time" class="event-input" required /></div><div><label asp-for="Input.EndTime" class="event-label">Ends at *</label><input asp-for="Input.EndTime" type="time" class="event-input" required /></div></div>
                </section>
                <section class="event-edit-section lg:col-span-4" aria-labelledby="edit-registration"><h2 id="edit-registration" class="event-edit-heading">Registration dates</h2>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
                        <div><label asp-for="Input.RegStart" class="event-label">Registration opens *</label><input asp-for="Input.RegStart" type="date" class="event-input" required min="1753-01-01" max="9998-12-31" /></div>
                        <div><label asp-for="Input.RegEnd" class="event-label">Registration deadline *</label><input asp-for="Input.RegEnd" type="date" class="event-input" required min="1753-01-01" max="9998-12-31" /></div>
                    </div>
                </section>
                <section class="event-edit-section lg:col-span-7" aria-labelledby="edit-audience"><h2 id="edit-audience" class="event-edit-heading">Target audience</h2>
                    <div class="grid gap-4 sm:grid-cols-2">
                    <div><label asp-for="Input.TargetBranch" class="event-label">Campus</label><select asp-for="Input.TargetBranch" class="event-input"><option value="">All campuses</option>@foreach (var campus in CreateEventInput.Branches) { <option>@campus</option> }</select></div>
                    <div><label asp-for="Input.TargetDepartment" class="event-label">Academic college</label><select asp-for="Input.TargetDepartment" class="event-input"><option value="">All colleges</option>@foreach (var college in CreateEventInput.ProgramOptions.Select(p => p.Department).Distinct()) { <option>@college</option> }</select></div>
                    <div><label asp-for="Input.TargetYearLevel" class="event-label">Year level</label><select asp-for="Input.TargetYearLevel" class="event-input"><option value="">All year levels</option>@for (var year = 1; year <= 5; year++) { <option value="@year">Year @year</option> }</select></div>
                    </div>
                    <fieldset><legend class="event-label">Programs (Optional)</legend><div class="grid gap-2 sm:grid-cols-3">@foreach (var program in CreateEventInput.ProgramOptions) { <label class="flex min-h-11 items-center gap-2 text-sm" data-program-college="@program.Department"><input type="checkbox" name="Input.Programs" value="@program.Code" checked="@Model.Input.Programs.Contains(program.Code)" />@program.Code</label> }</div></fieldset>
                </section>
                <section class="event-edit-section lg:col-span-5" aria-labelledby="edit-partners"><h2 id="edit-partners" class="event-edit-heading">Partners & sponsors</h2>
                    <p class="mb-4 text-sm text-campus-muted">One organization per field. Remove a sponsor with its Remove button.</p>
                    <div id="edit-sponsors" class="space-y-2">@for (var i = 0; i < Model.Input.Sponsors.Count; i++) { <div class="flex gap-2"><input name="Input.Sponsors[@i]" value="@Model.Input.Sponsors[i]" aria-label="Sponsor @(i + 1)" class="event-input" required maxlength="150" /><button type="button" data-remove-sponsor class="event-secondary">Remove</button></div> }</div>
                    <button type="button" id="edit-add-sponsor" class="@focus event-secondary mt-3">Add sponsor</button>
                </section>
            </div>
            <div class="mt-6 flex flex-wrap justify-end gap-3 border-t border-campus-line pt-5"><a asp-route="AdminEventDetails" asp-route-id="@ev.Id" class="@focus event-secondary">Cancel editing</a><button type="submit" class="@focus event-primary">Save changes</button></div>
        </form>
    }
    else
    {
        <div class="mt-6 grid items-start gap-8 xl:grid-cols-[minmax(0,1.7fr)_minmax(16rem,1fr)]">
            <div class="min-w-0 divide-y divide-campus-line">
                <section class="pb-6"><h2 class="text-base font-bold text-campus-navy">Event overview</h2><p class="mt-3 max-w-prose text-sm leading-7 whitespace-pre-wrap wrap-break-word text-campus-muted">@(string.IsNullOrWhiteSpace(ev.Description) ? "No description provided." : ev.Description)</p></section>
                <section class="py-6"><h2 class="text-base font-bold text-campus-navy">Schedule & registration</h2><dl class="mt-4 grid gap-x-8 gap-y-5 text-sm sm:grid-cols-2">
                    <div><dt class="mb-1 text-xs text-campus-muted">Event date</dt><dd class="font-semibold">@Date(DateOnly.FromDateTime(ev.Start))</dd></div>
                    <div><dt class="mb-1 text-xs text-campus-muted">Event time</dt><dd class="font-semibold tabular-nums">@ev.Start.ToString("h:mm tt", CultureInfo.InvariantCulture) – @ev.End.ToString("h:mm tt", CultureInfo.InvariantCulture)</dd></div>
                    <div><dt class="mb-1 text-xs text-campus-muted">Registration opens</dt><dd class="font-semibold tabular-nums">@Date(ev.RegistrationOpen)</dd></div>
                    <div><dt class="mb-1 text-xs text-campus-muted">Registration deadline</dt><dd class="font-semibold tabular-nums">@Date(ev.RegistrationDeadline)</dd></div>
                </dl></section>
                <section class="py-6"><h2 class="text-base font-bold text-campus-navy">Target audience</h2><dl class="mt-4 grid gap-x-8 gap-y-5 text-sm sm:grid-cols-2">
                    <div><dt class="mb-1 text-xs text-campus-muted">Campus</dt><dd class="font-semibold wrap-break-word">@(ev.Campus ?? "All campuses")</dd></div>
                    <div><dt class="mb-1 text-xs text-campus-muted">Academic college</dt><dd class="font-semibold wrap-break-word">@(ev.College ?? "All colleges")</dd></div>
                    <div><dt class="mb-1 text-xs text-campus-muted">Year level</dt><dd class="font-semibold">@(ev.Year is { } year ? $"Year {year}" : "All year levels")</dd></div>
                    <div><dt class="mb-1 text-xs text-campus-muted">Degree programs</dt><dd class="font-semibold wrap-break-word">@(ev.Programs?.Replace(",", ", ") ?? "All programs")</dd></div>
                </dl></section>
                <section class="py-6"><h2 class="text-base font-bold text-campus-navy">Partners & sponsors <span class="font-normal text-campus-muted">(@ev.Sponsors.Count)</span></h2>
                    @if (ev.Sponsors.Count == 0) { <p class="mt-3 text-sm text-campus-muted">No sponsors added to this event.</p> }
                    else { <ul class="mt-3 space-y-2 text-sm">@foreach (var sponsor in ev.Sponsors) { <li class="wrap-break-word">@sponsor</li> }</ul> }
                </section>
            </div>
            <aside class="rounded-xl border border-campus-line bg-campus-input p-5" aria-label="Promotional banner and seating">
                <h2 class="text-sm font-bold text-campus-navy">Promotional banner</h2>
                @if (ev.Banner is not null) { <img src="/admin/events/@ev.Id/banner" alt="Banner for @ev.Title" class="mt-4 max-h-64 w-full rounded-lg object-contain" /> }
                else { <div class="mt-4 grid aspect-video place-items-center rounded-lg border border-dashed border-campus-field bg-white p-4 text-center text-sm text-campus-muted">No banner uploaded</div> }
                <div class="mt-5 border-t border-campus-line pt-5"><p class="text-xs text-campus-muted">Registered students</p><p class="mt-2 text-2xl font-bold tabular-nums text-campus-navy">@ev.Registered <span class="text-sm font-normal text-campus-muted">/ @ev.Capacity seats</span></p>
                    <div role="progressbar" aria-label="Registered seats" aria-valuenow="@ev.Registered" aria-valuemin="0" aria-valuemax="@ev.Capacity" class="mt-3 h-1.5 overflow-hidden rounded-full bg-campus-line"><span class="block h-full bg-campus-action" style="width:@((100m * ev.Registered / ev.Capacity).ToString("0.##", CultureInfo.InvariantCulture))%"></span></div>
                    <div class="mt-2 flex flex-wrap justify-between gap-2 text-xs text-campus-muted"><span>@(ev.Capacity - ev.Registered) seats available</span><span>@((100m * ev.Registered / ev.Capacity).ToString("0.#", CultureInfo.InvariantCulture))% filled</span></div>
                </div>
            </aside>
        </div>
        @if (Model.CanManage)
        {
            <dialog id="cancel-event" class="event-cancel-dialog" aria-labelledby="cancel-event-title" aria-describedby="cancel-event-description" data-reopen="@(ViewData["OpenCancellation"] is true ? "true" : "false")">
                <div class="flex items-start justify-between gap-4">
                    <h2 id="cancel-event-title" class="text-xl font-bold text-campus-navy">Cancel this event?</h2>
                    <button type="button" data-close-cancellation class="@focus event-secondary shrink-0" aria-label="Close cancellation dialog">Close</button>
                </div>
                <p id="cancel-event-description" class="mt-3 text-sm leading-6 text-campus-muted">You are cancelling <strong class="wrap-break-word text-campus-ink">@ev.Title</strong>. Existing registrations will be kept as history.</p>
                @if (ViewData["OpenCancellation"] is true) { <div asp-validation-summary="All" role="alert" class="mt-4 text-sm text-red-800"></div> }
                <form asp-action="Cancel" asp-route-id="@ev.Id" method="post" class="mt-5">
                    <input type="hidden" name="version" value="@(ViewData["CancelVersion"] as string ?? token)" />
                    <label for="cancellation-reason" class="event-label">Cancellation reason *</label><textarea id="cancellation-reason" name="reason" required maxlength="500" rows="3" class="event-input">@(ViewData["CancellationReason"] as string)</textarea>
                    <label class="mt-4 flex min-h-11 items-start gap-3 text-sm"><input type="checkbox" name="confirmed" value="true" required class="mt-1" /><span>I confirm this cancellation. Existing registrations will be kept as history.</span></label>
                    <div class="mt-6 flex flex-wrap justify-end gap-3 border-t border-campus-line pt-5">
                        <button type="button" data-close-cancellation autofocus class="@focus event-secondary">Keep event</button>
                        <button type="submit" class="@focus event-primary border-red-800 bg-red-800 hover:bg-red-900">Confirm cancellation</button>
                    </div>
                </form>
            </dialog>
        }
    }
</main>
@section Scripts { <script src="~/js/admin/event-details.js" asp-append-version="true" defer></script> }
