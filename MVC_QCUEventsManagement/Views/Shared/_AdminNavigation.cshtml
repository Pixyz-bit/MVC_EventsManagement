@{
    var currentSection = ViewData["AdminSection"] as string;
    var previewMode = ViewData["PreviewMode"] is true;
    var accountName = User.Identity?.Name is { Length: > 0 } name ? name : "Administrator";
    (string Title, (string Label, string Icon, string? Route)[] Links)[] groups =
    [
        ("Core Management",
        [
            ("Event Directory", "M4 10h16M8 3v4m8-4v4M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z", "AdminEvents"),
            ("Create Event", "M12 8v8m-4-4h8m5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", "AdminCreateEvent"),
            ("Events History", "M12 7v5l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", null)
        ]),
        ("Attendance & Users",
        [
            ("Student Directory", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z", null),
            ("Account Management", "M12 22s7-4 7-10V6l-7-3-7 3v6c0 6 7 10 7 10Z", null)
        ])
    ];
    const string row = "flex min-h-11 items-center rounded-lg border-l-2 pr-2.5 pl-10";
}

<nav aria-label="Administrator navigation" class="space-y-5 px-3 py-4 lg:min-h-0 lg:flex-1 lg:overflow-y-auto">
    @foreach (var group in groups)
    {
        <div>
            <p class="px-3 text-xs font-bold tracking-wide text-slate-500 uppercase">@group.Title</p>
            <ul class="mt-1.5 space-y-0.5 text-sm">
                @foreach (var link in group.Links)
                {
                    var isCurrent = link.Route == "AdminEvents" && currentSection == "Events"
                        || link.Route == "AdminCreateEvent" && currentSection == "Create";
                    <li class="relative">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                             class="pointer-events-none absolute top-1/2 left-3 size-4.5 -translate-y-1/2 @(isCurrent ? "text-blue-700" : "text-slate-500")">
                            <path d="@link.Icon" />
                        </svg>
                        @if (link.Route is not null)
                        {
                            var route = previewMode ? link.Route == "AdminEvents" ? "PreviewAdminEvents" : "PreviewCreateEvent" : link.Route;
                            <a asp-route="@route" aria-current="@(isCurrent ? "page" : null)"
                               class="@row font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-campus-focus @(isCurrent ? "border-blue-600 bg-blue-50 text-blue-700" : "border-transparent text-campus-ink hover:bg-campus-input")">
                                @link.Label
                            </a>
                        }
                        else
                        {
                            <span role="link" aria-disabled="true" class="@row border-transparent font-medium text-campus-muted">@link.Label</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</nav>

<div class="grid shrink-0 grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2 border-t border-campus-line bg-white px-3 py-2">
    <span aria-hidden="true" class="grid size-9 place-items-center rounded-full border border-blue-200 bg-blue-50 text-xs font-bold text-blue-700">
        @accountName[0].ToString().ToUpperInvariant()
    </span>
    <div class="min-w-0">
        <p class="wrap-break-word text-sm leading-tight font-semibold">@accountName</p>
        <p class="mt-1 text-xs font-medium text-emerald-700">Administrator</p>
    </div>
    @if (previewMode)
    {
        <a href="/login" class="inline-flex min-h-11 items-center rounded-lg px-2 text-xs font-semibold text-campus-action underline focus-visible:outline-2 focus-visible:outline-campus-focus">Sign in</a>
    }
    else
    {
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" aria-label="Sign out" title="Sign out"
                class="grid size-11 place-items-center rounded-lg text-slate-600 hover:bg-campus-input hover:text-campus-ink focus-visible:outline-2 focus-visible:outline-campus-focus">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4.5">
                <path d="M10 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h5m5-12 4 4-4 4m4-4H9" />
            </svg>
        </button>
    </form>
    }
</div>
