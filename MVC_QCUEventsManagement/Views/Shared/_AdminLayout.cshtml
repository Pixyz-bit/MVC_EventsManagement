@{
    Layout = "_AccountLayout";
}

<a href="#admin-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-20 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-semibold focus:text-campus-navy focus:outline-2 focus:outline-campus-focus">
    Skip to content
</a>

<div class="min-h-dvh bg-white lg:grid lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="sticky top-0 hidden h-dvh border-r border-campus-line bg-white lg:flex lg:flex-col" aria-label="Administrator sidebar">
        <div class="shrink-0 border-b border-campus-line px-4 py-2.5">
            <a asp-route="@(ViewData["PreviewMode"] is true ? "PreviewAdminEvents" : "AdminPortal")" class="flex min-h-11 items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-campus-focus">
                <img src="~/images/qcu-logo.png" alt="" class="size-9 shrink-0 object-contain" width="36" height="36" />
                <span class="leading-tight">
                    <strong class="block text-base text-campus-navy">QCU Events</strong>
                    <span class="mt-0.5 block text-xs font-semibold text-campus-muted">Administrator portal</span>
                </span>
            </a>
        </div>
        <partial name="_AdminNavigation" />
    </aside>

    <header class="border-b border-campus-line bg-white lg:hidden">
        <details class="group relative">
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 px-5 focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-campus-focus [&::-webkit-details-marker]:hidden">
                <span class="flex min-w-0 items-center gap-3">
                    <img src="~/images/qcu-logo.png" alt="" class="size-8 shrink-0" width="32" height="32" />
                    <strong class="text-sm">QCU Events</strong>
                </span>
                <span class="flex items-center gap-2 rounded-lg border border-campus-line px-3 py-2 text-sm font-semibold">
                    Menu<span aria-hidden="true" class="size-2 -translate-y-0.5 rotate-45 border-r-2 border-b-2 group-open:translate-y-0.5 group-open:rotate-225"></span>
                </span>
            </summary>
            <div class="border-t border-campus-line @(ViewData["ViewportForm"] is true ? "absolute inset-x-0 top-16 z-30 max-h-[calc(100dvh-4rem)] overflow-y-auto bg-white shadow-lg" : "")">
                <partial name="_AdminNavigation" />
            </div>
        </details>
    </header>

    <div id="admin-content" tabindex="-1" class="min-w-0">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
