@using System.Globalization
@using System.Text.Json
@using MVC_QCUEventsManagement.ViewModels.Admin
@using MVC_QCUEventsManagement.Services
@model StudentDirectoryViewModel
@{
    Layout = "_AdminLayout"; ViewData["Title"] = "Student Directory"; ViewData["AdminSection"] = "Students";
    var q = Model.Query;
    var columns = "xl:grid-cols-[8rem_minmax(0,1fr)_minmax(0,1.25fr)_7rem_5rem_4rem]";
    var json = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    Dictionary<string,string> Routes(int page) => new() { ["q"] = q.Q ?? "", ["college"] = q.College ?? "", ["program"] = q.Program ?? "", ["campus"] = q.Campus ?? "", ["status"] = q.Status ?? "", ["page"] = page.ToString(CultureInfo.InvariantCulture) };
}
<main id="student-directory" class="w-full px-4 pt-6 pb-8 sm:px-6 sm:pt-7 lg:px-8" data-reopen="@Model.Reopen">
    <header class="flex flex-wrap items-start justify-between gap-4"><div><h1 class="text-2xl font-extrabold tracking-tight text-campus-navy sm:text-[1.75rem]">Student Directory</h1><p class="mt-2 text-sm text-campus-muted">Student profiles, academic details and account access.</p></div><div class="flex flex-wrap gap-2"><button type="button" data-open-student-import class="event-secondary">Import CSV</button><button type="button" data-add-student class="event-primary">Add student</button></div></header>
    @if (TempData["StudentMessage"] is string message) { <p role="status" class="mt-5 rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">@message</p> }
    @if (TempData["StudentError"] is string error) { <p role="alert" class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">@error</p> }
    @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" role="alert" class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800"></div> }
    <section aria-label="Student directory" class="mt-6 overflow-hidden rounded-xl border border-campus-line bg-white">
        <form asp-route="AdminStudentDirectory" method="get" role="search" class="space-y-3 p-4">
            <div class="grid gap-3 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)_minmax(0,.8fr)]"><div class="min-w-0"><label for="student-search" class="event-label">Search students</label><input id="student-search" type="search" name="q" value="@q.Q" maxlength="150" placeholder="Student ID or full name" class="event-input" /></div><div class="min-w-0"><label for="student-college" class="event-label">College</label><select id="student-college" name="college" class="event-input"><option value="">All colleges</option>@foreach (var college in Model.Colleges.Union(q.College is null ? [] : new[] { q.College }).Order()) { <option selected="@(q.College == college)">@college</option> }</select></div><div class="min-w-0"><label for="student-program" class="event-label">Program</label><select id="student-program" name="program" class="event-input"><option value="">All programs</option>@foreach (var program in Model.Programs.Union(q.Program is null ? [] : new[] { q.Program }).Order()) { <option selected="@(q.Program == program)">@program</option> }</select></div></div>
            <div class="flex flex-wrap items-end gap-3"><div class="min-w-0 flex-1 basis-40 sm:max-w-48"><label for="student-campus" class="event-label">Campus</label><select id="student-campus" name="campus" class="event-input"><option value="">All campuses</option>@foreach (var campus in CreateEventInput.Branches.Union(q.Campus is null ? [] : new[] { q.Campus })) { <option selected="@(q.Campus == campus)">@campus</option> }</select></div><div class="min-w-0 flex-1 basis-36 sm:max-w-44"><label for="student-status" class="event-label">Account status</label><select id="student-status" name="status" class="event-input"><option value="">All statuses</option><option selected="@(q.Status == "Active")">Active</option><option selected="@(q.Status == "Inactive")">Inactive</option></select></div><button type="submit" class="event-primary">Search</button><a asp-route="AdminStudentDirectory" class="event-secondary">Reset filters</a><a asp-action="Export" asp-all-route-data="@Routes(1)" class="event-secondary sm:ml-auto">Export CSV</a></div>
        </form>
        <div aria-hidden="true" class="@columns hidden items-center gap-4 border-y border-campus-line bg-campus-input px-4 py-3 text-xs font-semibold text-campus-muted xl:grid"><span>Student ID</span><span>Student</span><span>College &amp; program</span><span>Campus</span><span>Status</span><span>Action</span></div>
        <ul role="list" class="divide-y divide-campus-line">
            @for (var i = 0; i < Model.Students.Count; i++)
            {
                var student = Model.Students[i];
                <li class="@columns grid items-center gap-4 px-4 py-5 text-sm sm:grid-cols-2"><div class="min-w-0"><span class="mb-1 block text-xs text-campus-muted xl:sr-only">Student ID</span><span class="text-xs wrap-break-word tabular-nums">@student.StudentId</span></div><div class="min-w-0"><span class="mb-1 block text-xs text-campus-muted xl:sr-only">Student</span><h2 class="text-sm font-semibold wrap-break-word">@student.Name</h2></div><div class="min-w-0"><p class="text-sm font-semibold wrap-break-word">@student.Program</p><p class="mt-1 text-xs wrap-break-word text-campus-muted">@student.College</p></div><div class="min-w-0"><span class="mb-1 block text-xs text-campus-muted xl:sr-only">Campus</span><p class="text-xs wrap-break-word">@student.Campus</p></div><div><span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold @(student.Active ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800")">@(student.Active ? "Active" : "Inactive")</span></div><div><button type="button" data-student-view="@i" class="event-secondary" aria-label="View @student.Name">View</button></div></li>
            }
        </ul>
        @if (Model.Students.Count == 0) { <div class="border-t border-campus-line px-4 py-10 text-center"><h2 class="text-base font-bold text-campus-navy">No students found</h2><p class="mt-2 text-sm text-campus-muted">Try another search or reset the filters. Add a student or import a roster to create profiles.</p></div> }
        <nav aria-label="Student pages" class="flex flex-wrap items-center justify-between gap-3 border-t border-campus-line px-4 py-3 text-xs text-campus-muted"><span>@Model.Total students · Page @q.Page of @Model.TotalPages</span><div class="flex gap-2">@if (q.Page > 1) { <a asp-route="AdminStudentDirectory" asp-all-route-data="@Routes(q.Page - 1)" class="event-secondary">Previous</a> }@if (q.Page < Model.TotalPages) { <a asp-route="AdminStudentDirectory" asp-all-route-data="@Routes(q.Page + 1)" class="event-secondary">Next</a> }</div></nav>
    </section>
    <dialog id="student-profile" class="student-directory-dialog" aria-labelledby="student-profile-title"><div class="flex items-start justify-between gap-4 border-b border-campus-line pb-4"><div><h2 id="student-profile-title" class="text-xl font-bold">Student profile</h2><p data-profile-id class="mt-1 text-xs text-campus-muted"></p></div><button type="button" data-close-student-dialog class="event-secondary">Close</button></div><div class="mt-5 flex flex-wrap items-center gap-3"><h3 data-profile-name class="text-lg font-bold wrap-break-word"></h3><span data-profile-status class="rounded-full bg-campus-input px-3 py-1 text-xs font-semibold"></span></div><div class="mt-5 grid gap-4 sm:grid-cols-2"><section class="rounded-xl border border-campus-line p-4"><h3 class="border-b border-campus-line pb-3 text-sm font-bold">Personal information</h3><dl class="mt-4 space-y-4 text-sm"><div><dt class="text-xs text-campus-muted">Institutional email</dt><dd data-profile-email class="mt-1 wrap-break-word"></dd></div><div><dt class="text-xs text-campus-muted">Birthdate</dt><dd data-profile-birth-date class="mt-1"></dd></div><div><dt class="text-xs text-campus-muted">Gender</dt><dd data-profile-gender class="mt-1"></dd></div></dl></section><section class="rounded-xl border border-campus-line p-4"><h3 class="border-b border-campus-line pb-3 text-sm font-bold">Academic placement</h3><dl class="mt-4 space-y-4 text-sm"><div><dt class="text-xs text-campus-muted">Campus</dt><dd data-profile-campus class="mt-1"></dd></div><div><dt class="text-xs text-campus-muted">College</dt><dd data-profile-college class="mt-1 wrap-break-word"></dd></div><div><dt class="text-xs text-campus-muted">Program</dt><dd data-profile-program class="mt-1 wrap-break-word"></dd></div></dl></section></div><p class="mt-4 rounded-lg bg-campus-input p-3 text-xs text-campus-muted">Year level and section are recorded when a student registers for an event.</p><div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-campus-line pt-4"><button type="button" data-student-access class="event-secondary">Change account access</button><button type="button" data-student-password class="event-secondary">Reset password</button><button type="button" data-edit-student class="event-primary">Edit profile</button></div></dialog>
    <dialog id="student-editor" class="student-directory-dialog" aria-labelledby="student-editor-title">
        <form asp-action="Create" method="post" id="student-profile-form" data-create-url="@Url.Action("Create")" data-edit-url="@Url.Action("Edit")">
            <partial name="_QueryFields" model="q" /><input asp-for="Input.Token" type="hidden" />
            <div class="flex items-start justify-between gap-4 border-b border-campus-line pb-4"><h2 id="student-editor-title" class="text-xl font-bold">Add student</h2><button type="button" data-close-student-dialog class="event-secondary">Close</button></div>
            @if (!ViewData.ModelState.IsValid && Model.Reopen is "create" or "edit") { <div asp-validation-summary="All" role="alert" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800"></div> }
            <div class="mt-5 grid gap-4 sm:grid-cols-2"><h3 class="text-sm font-bold sm:col-span-2">Identity &amp; contact</h3><div><label asp-for="Input.StudentId" class="event-label">Student ID *</label><input asp-for="Input.StudentId" class="event-input" required maxlength="50" /></div><div><label asp-for="Input.Email" class="event-label">Institutional email *</label><input asp-for="Input.Email" type="email" class="event-input" required maxlength="150" /></div><div><label asp-for="Input.FirstName" class="event-label">First name *</label><input asp-for="Input.FirstName" class="event-input" required maxlength="100" /></div><div><label asp-for="Input.MiddleName" class="event-label">Middle name (Optional)</label><input asp-for="Input.MiddleName" class="event-input" maxlength="100" /></div><div><label asp-for="Input.LastName" class="event-label">Last name *</label><input asp-for="Input.LastName" class="event-input" required maxlength="100" /></div><div><label asp-for="Input.BirthDate" class="event-label">Birthdate <span data-birth-required>*</span></label><input asp-for="Input.BirthDate" type="date" class="event-input" min="1900-01-01" /></div><div><label asp-for="Input.Gender" class="event-label">Gender *</label><select asp-for="Input.Gender" class="event-input">@foreach (var gender in StudentService.Genders) { <option>@gender</option> }</select></div>
                <h3 class="mt-2 border-t border-campus-line pt-4 text-sm font-bold sm:col-span-2">Academic placement</h3><div><label asp-for="Input.Campus" class="event-label">Campus *</label><select asp-for="Input.Campus" class="event-input">@foreach (var campus in CreateEventInput.Branches) { <option>@campus</option> }</select></div><div><label asp-for="Input.College" class="event-label">College *</label><select asp-for="Input.College" class="event-input">@foreach (var college in CreateEventInput.ProgramOptions.Select(p => p.Department).Distinct()) { <option>@college</option> }</select></div><div><label asp-for="Input.Program" class="event-label">Program *</label><select asp-for="Input.Program" class="event-input">@foreach (var program in CreateEventInput.ProgramOptions) { <option value="@program.Code" data-college="@program.Department" data-alias="@("BS " + program.Name)">@program.Code</option> }</select></div>
                <h3 class="mt-2 border-t border-campus-line pt-4 text-sm font-bold sm:col-span-2">Account access</h3><div><label asp-for="Input.Active" class="event-label">Account status</label><select asp-for="Input.Active" class="event-input"><option value="true">Active</option><option value="false">Inactive</option></select></div><div data-initial-password><label for="student-initial-password" class="event-label">Password *</label><input id="student-initial-password" name="Input.Password" type="password" minlength="15" maxlength="128" autocomplete="new-password" class="event-input" /><p class="mt-1 text-xs text-campus-muted">15–128 characters. Share it privately with the student.</p></div>
            </div><div class="mt-6 flex flex-wrap justify-end gap-2 border-t border-campus-line pt-4"><button type="button" data-close-student-dialog class="event-secondary">Cancel</button><button type="submit" class="event-primary">Save student</button></div>
        </form>
    </dialog>
    <dialog id="student-access" class="event-cancel-dialog" aria-labelledby="student-access-title"><form asp-action="Access" method="post"><partial name="_QueryFields" model="q" /><input name="id" type="hidden" data-selected-student-id /><input name="token" type="hidden" data-selected-student-token /><input name="active" type="hidden" data-selected-student-active /><h2 id="student-access-title" class="text-xl font-bold">Change student account access?</h2><p data-account-description class="mt-4 text-sm text-campus-muted"></p><p class="mt-3 text-xs text-campus-muted">The profile and registration history are retained.</p><label class="mt-4 flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="confirmed" value="true" required /> Confirm this access change</label><div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-campus-line pt-4"><button type="button" data-close-student-dialog class="event-secondary">Keep current access</button><button type="submit" class="event-primary">Confirm change</button></div></form></dialog>
    <dialog id="student-password" class="event-cancel-dialog" aria-labelledby="student-password-title"><form asp-action="Password" method="post"><partial name="_QueryFields" model="q" /><input name="id" type="hidden" data-selected-student-id /><input name="token" type="hidden" data-selected-student-token /><h2 id="student-password-title" class="text-xl font-bold">Reset student password</h2><p data-password-student class="mt-3 text-sm text-campus-muted"></p><div class="mt-4"><label for="student-reset-password" class="event-label">New password *</label><input id="student-reset-password" type="password" name="password" minlength="15" maxlength="128" required autocomplete="new-password" class="event-input" /></div><label class="mt-4 flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="confirmed" value="true" required /> Confirm this password reset</label><div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-campus-line pt-4"><button type="button" data-close-student-dialog class="event-secondary">Cancel</button><button type="submit" class="event-primary">Reset password</button></div></form></dialog>
    <dialog id="student-import" class="student-directory-dialog" aria-labelledby="student-import-title"><form asp-action="Import" method="post" enctype="multipart/form-data"><partial name="_QueryFields" model="q" /><div class="flex items-start justify-between gap-4 border-b border-campus-line pb-4"><h2 id="student-import-title" class="text-xl font-bold">Import student roster</h2><button type="button" data-close-student-dialog class="event-secondary">Close</button></div><p class="mt-4 text-sm text-campus-muted">UTF-8 CSV · Up to 2 MB and 200 students per file. Valid rows are saved; invalid rows are reported separately.</p><div class="mt-5"><label for="student-roster" class="event-label">Student roster (.csv) *</label><input id="student-roster" name="roster" type="file" accept=".csv,text/csv" required class="event-input" /></div><div class="mt-4"><label for="student-import-password" class="event-label">Initial password for imported accounts *</label><input id="student-import-password" name="password" type="password" required minlength="15" maxlength="128" autocomplete="new-password" class="event-input" /><p class="mt-2 text-xs text-campus-muted">15–128 characters. Each account stores its own salted hash. Share access privately; passwords are not included in CSV exports.</p></div><a asp-action="Template" class="event-secondary mt-4">Download template</a>
            @if (!ViewData.ModelState.IsValid && Model.Reopen == "import") { <div asp-validation-summary="All" role="alert" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800"></div> }
            @if (Model.ImportReport is { } report) { <section aria-label="Import result" class="mt-5 rounded-lg border border-campus-line p-4"><h3 class="text-sm font-bold">@report.Created created · @report.Errors.Count errors</h3>@if (report.Errors.Count > 0) { <ul class="mt-3 space-y-2 text-sm text-red-800">@foreach (var row in report.Errors) { <li>Row @row.Row: @row.Message</li> }</ul> }</section> }
            <div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-campus-line pt-4"><button type="button" data-close-student-dialog class="event-secondary">Close</button><button type="submit" class="event-primary">Import roster</button></div>
        </form></dialog>
    <script type="application/json" id="student-directory-data">@Html.Raw(JsonSerializer.Serialize(Model.Students, json))</script>
    <script type="application/json" id="student-directory-initial">@Html.Raw(JsonSerializer.Serialize(Model.Input, json))</script>
</main>
@section Scripts { <script src="~/js/admin/student-directory.js" asp-append-version="true" defer></script> }
