@using MVC_QCUEventsManagement.Services
@using MVC_QCUEventsManagement.ViewModels.Admin
@model AccountManagementViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Account Management";
    ViewData["AdminSection"] = "Accounts";
    var editor = Model.Editor;
    var self = editor?.Id == Model.ActorId;
}
<main class="w-full px-4 pt-6 pb-8 sm:px-6 lg:px-8">
    <header class="flex flex-wrap items-start justify-between gap-4">
        <div><h1 class="text-2xl font-extrabold tracking-tight text-campus-navy">Account Management</h1><p class="mt-2 text-sm text-campus-muted">Manage sign-in access, roles and account credentials.</p></div>
        <div class="flex flex-wrap gap-2">
            <a asp-route="AdminStudentDirectory" asp-route-open="import" class="event-secondary">Batch CSV import</a>
            <a asp-route="AdminStudentDirectory" asp-route-open="create" class="event-primary">Add new student</a>
        </div>
    </header>
    @if (TempData["AccountMessage"] is string message)
    {
        <p role="status" class="mt-5 rounded-lg bg-emerald-50 p-4 text-sm text-emerald-800">@message</p>
    }
    <dl class="mt-6 grid grid-cols-2 gap-4 border-y border-campus-line py-4 md:grid-cols-4">
        @foreach (var (label, count) in new[] { ("Total accounts", Model.Total), ("Active administrators", Model.Admins), ("Active students", Model.Students), ("Inactive accounts", Model.Inactive) })
        {
            <div><dt class="text-xs text-campus-muted">@label</dt><dd class="mt-1 text-2xl font-bold tabular-nums">@count</dd></div>
        }
    </dl>
    <section aria-label="Accounts" class="mt-6 rounded-xl border border-campus-line">
        <form asp-route="AdminAccounts" method="get" class="relative flex flex-wrap items-end gap-3 p-4">
            <div class="min-w-0 flex-1 basis-52"><label for="account-search" class="event-label">Search accounts</label><input id="account-search" name="q" type="search" value="@Model.Q" maxlength="150" class="event-input" placeholder="Email, name or student ID" /></div>
            <button type="submit" class="event-secondary">Search</button>
            <details class="directory-filter-menu">
                <summary class="event-secondary cursor-pointer list-none">Filters @if (Model.Role.Length + Model.Status.Length > 0) { <span class="rounded bg-blue-50 px-1.5 text-campus-action">@((Model.Role.Length > 0 ? 1 : 0) + (Model.Status.Length > 0 ? 1 : 0))</span> }</summary>
                <div class="directory-filter-panel">
                    <div><label for="account-filter-role" class="event-label">Role</label><select id="account-filter-role" name="role" class="event-input"><option value="">All roles</option><option value="Admin" selected="@(Model.Role == "Admin")">Administrator</option><option value="Student" selected="@(Model.Role == "Student")">Student</option></select></div>
                    <div><label for="account-filter-status" class="event-label">Account status</label><select id="account-filter-status" name="status" class="event-input"><option value="">All statuses</option><option selected="@(Model.Status == "Active")">Active</option><option selected="@(Model.Status == "Inactive")">Inactive</option></select></div>
                    <div class="flex flex-wrap gap-2"><a asp-route="AdminAccounts" asp-route-q="@Model.Q" class="event-secondary">Reset</a><button type="submit" class="event-primary">Apply filters</button></div>
                </div>
            </details>
            <a asp-action="Export" asp-route-q="@Model.Q" asp-route-role="@Model.Role" asp-route-status="@Model.Status" class="event-secondary">Export CSV</a>
        </form>
        <div class="overflow-x-auto rounded-b-xl">
            <table class="w-full text-left text-sm">
                <thead class="border-y border-campus-line bg-campus-input text-xs text-campus-muted"><tr><th scope="col" class="px-4 py-3">Account</th><th scope="col" class="px-3 py-3">Role</th><th scope="col" class="px-3 py-3">Status</th><th scope="col" class="px-4 py-3 text-right">Action</th></tr></thead>
                <tbody class="divide-y divide-campus-line">
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="px-4 py-4"><strong class="wrap-anywhere">@row.Email</strong>@if (row.Id == Model.ActorId) { <span class="ml-2 text-xs text-campus-action">You</span> }@if (row.StudentId is not null) { <p class="mt-1 text-xs text-campus-muted">@row.Name · @row.StudentId</p> }</td>
                        <td class="px-3 py-4">@(row.Role == "Admin" ? "Administrator" : row.Role)</td>
                        <td class="px-3 py-4"><span class="rounded-full px-2 py-1 text-xs font-semibold @(row.Active ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800")">@(row.Active ? "Active" : "Inactive")</span></td>
                        <td class="px-4 py-4 text-right"><a asp-route="AdminAccounts" asp-route-id="@row.Id" asp-route-q="@Model.Q" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="@Model.Page" class="event-secondary" aria-label="View @row.Email">View</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.Rows.Count == 0) { <p class="p-8 text-center text-sm text-campus-muted">No accounts match these filters.</p> }
        <nav aria-label="Account pages" class="flex flex-wrap items-center justify-between gap-2 border-t border-campus-line p-4 text-xs text-campus-muted">
            <span>@Model.Matches accounts · Page @Model.Page of @Model.Pages</span>
            <div class="flex gap-2">
                @if (Model.Page > 1) { <a asp-route="AdminAccounts" asp-route-q="@Model.Q" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)" class="event-secondary">Previous</a> }
                @if (Model.Page < Model.Pages) { <a asp-route="AdminAccounts" asp-route-q="@Model.Q" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)" class="event-secondary">Next</a> }
            </div>
        </nav>
    </section>
    @if (editor is not null)
    {
        <dialog open id="account-profile-dialog" class="student-directory-dialog" aria-labelledby="account-profile-title" data-student="@(editor.Role == "Student" ? "true" : "false")">
            <form asp-action="Save" method="post">
                <input asp-for="Editor!.Id" type="hidden" /><input asp-for="Editor!.Version" type="hidden" />
                <input type="hidden" name="q" value="@Model.Q" /><input type="hidden" name="role" value="@Model.Role" /><input type="hidden" name="status" value="@Model.Status" /><input type="hidden" name="page" value="@Model.Page" />
                <header class="flex flex-wrap items-start justify-between gap-3 border-b border-campus-line pb-4">
                    <div><h2 id="account-profile-title" class="text-xl font-bold">@(editor.Role == "Student" ? "Student profile" : "Account details")</h2><p class="mt-1 text-sm wrap-anywhere text-campus-muted">@(string.IsNullOrWhiteSpace(editor.StudentId) ? editor.Email : $"{editor.FirstName} {editor.LastName} · {editor.StudentId}")</p></div>
                    <a asp-route="AdminAccounts" asp-route-q="@Model.Q" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="@Model.Page" class="event-secondary">Close</a>
                </header>
                <div asp-validation-summary="All" class="mt-3 text-sm text-rose-800"></div>
                <div role="tablist" aria-label="Profile information" class="mt-4 flex flex-wrap gap-2 border-b border-campus-line pb-3" hidden>
                    <button id="account-student-tab" type="button" role="tab" aria-controls="account-student-panel" aria-selected="false" class="event-secondary aria-selected:border-blue-300 aria-selected:bg-blue-50 aria-selected:text-campus-action">Student Information</button>
                    <button id="account-info-tab" type="button" role="tab" aria-controls="account-info-panel" aria-selected="true" class="event-secondary aria-selected:border-blue-300 aria-selected:bg-blue-50 aria-selected:text-campus-action">Account Information</button>
                </div>
                <section id="account-student-panel" role="tabpanel" aria-labelledby="account-student-tab" class="mt-5 grid gap-4 sm:grid-cols-2">
                    <div><label asp-for="Editor!.StudentId" class="event-label">Student ID</label><input asp-for="Editor!.StudentId" readonly="@editor.HasStudentProfile" maxlength="50" class="event-input" /></div>
                    <div><label asp-for="Editor!.Campus" class="event-label">Campus</label><select asp-for="Editor!.Campus" class="event-input"><option value="">Select campus</option>@foreach (var campus in CreateEventInput.Branches.Union(new[] { editor.Campus }).Where(c => !string.IsNullOrEmpty(c))) { <option>@campus</option> }</select></div>
                    <div><label asp-for="Editor!.FirstName" class="event-label">First name</label><input asp-for="Editor!.FirstName" maxlength="100" class="event-input" /></div>
                    <div><label asp-for="Editor!.MiddleName" class="event-label">Middle name (Optional)</label><input asp-for="Editor!.MiddleName" maxlength="100" class="event-input" /></div>
                    <div><label asp-for="Editor!.LastName" class="event-label">Last name</label><input asp-for="Editor!.LastName" maxlength="100" class="event-input" /></div>
                    <div><label for="account-birthdate" class="event-label">Birthdate</label><input id="account-birthdate" value="@(editor.BirthDate?.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "Not recorded")" readonly class="event-input" /></div>
                    <div><label asp-for="Editor!.Gender" class="event-label">Gender</label><select asp-for="Editor!.Gender" class="event-input"><option value="">Select gender</option>@foreach (var gender in StudentService.Genders.Union(new[] { editor.Gender }).Where(g => !string.IsNullOrEmpty(g))) { <option>@gender</option> }</select></div>
                    <div><label asp-for="Editor!.College" class="event-label">College</label><select asp-for="Editor!.College" class="event-input"><option value="">Select college</option>@foreach (var college in CreateEventInput.ProgramOptions.Select(p => p.Department).Union(new[] { editor.College }).Where(c => !string.IsNullOrEmpty(c))) { <option>@college</option> }</select></div>
                    <div class="sm:col-span-2"><label asp-for="Editor!.Program" class="event-label">Academic program</label><select asp-for="Editor!.Program" class="event-input"><option value="">Select program</option>@foreach (var program in CreateEventInput.ProgramOptions) { <option value="@program.Code" data-college="@program.Department">@program.Code</option> }@if (!string.IsNullOrEmpty(editor.Program) && !CreateEventInput.ProgramOptions.Any(p => p.Code == editor.Program)) { <option data-college="@editor.College">@editor.Program</option> }</select></div>
                </section>
                <section id="account-info-panel" role="tabpanel" aria-labelledby="account-info-tab" class="mt-5 grid gap-4 sm:grid-cols-2">
                    <div class="sm:col-span-2"><label asp-for="Editor!.Email" class="event-label">Email address</label><input asp-for="Editor!.Email" type="email" maxlength="150" required class="event-input" /></div>
                    @if (self) { <input type="hidden" name="Editor.Role" value="Admin" /><input type="hidden" name="Editor.Active" value="true" /> }
                    <div><label asp-for="Editor!.Role" class="event-label">Role</label><select asp-for="Editor!.Role" disabled="@self" class="event-input"><option value="Admin">Administrator</option><option value="Student">Student</option></select></div>
                    <div><label asp-for="Editor!.Active" class="event-label">Account access status</label><select asp-for="Editor!.Active" disabled="@self" class="event-input"><option value="true">Active</option><option value="false">Inactive</option></select></div>
                    @if (self) { <p class="text-xs text-campus-muted sm:col-span-2">Your account must remain an active administrator.</p> }
                    <div class="sm:col-span-2"><label for="account-new-password" class="event-label">New password (Optional)</label><input id="account-new-password" name="Editor.Password" type="password" minlength="15" maxlength="128" autocomplete="new-password" class="event-input" /><p class="mt-1 text-xs text-campus-muted">Use 15–128 characters. Leave blank to keep the current password.</p></div>
                </section>
                <footer class="mt-6 flex flex-wrap justify-end gap-2 border-t border-campus-line pt-4">
                    <a asp-route="AdminAccounts" asp-route-q="@Model.Q" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="@Model.Page" class="event-secondary">Cancel</a>
                    <button type="submit" class="event-primary">Save changes</button>
                </footer>
            </form>
        </dialog>
    }
</main>
@section Scripts {
    <script src="~/js/admin/account-management.js" asp-append-version="true" defer></script>
}
