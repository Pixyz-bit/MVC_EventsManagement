@model MVC_QCUEventsManagement.ViewModels.Admin.UserDirectoryViewModel
    <dialog id="student-import" open="@(Model.Open == "import")" class="student-directory-dialog" aria-labelledby="student-import-title"><form asp-route="AdminUserImport" method="post" enctype="multipart/form-data"><partial name="_QueryFields" model="Model.Query" /><div class="flex items-start justify-between gap-4 border-b border-campus-line pb-4"><h2 id="student-import-title" class="text-xl font-bold">Import student roster</h2><button type="button" data-close-user-dialog class="event-secondary">Close</button></div><p class="mt-4 text-sm text-campus-muted">UTF-8 CSV · Up to 2 MB and 200 students per file. Valid rows are saved; invalid rows are reported separately.</p><div class="mt-5"><label for="student-roster" class="event-label">Student roster (.csv) *</label><input id="student-roster" name="roster" type="file" accept=".csv,text/csv" required class="event-input" /></div><div class="mt-4"><label for="student-import-password" class="event-label">Initial password for imported accounts *</label><input id="student-import-password" name="password" type="password" required minlength="15" maxlength="128" autocomplete="new-password" class="event-input" /><p class="mt-2 text-xs text-campus-muted">15–128 characters. Each account stores its own salted hash. Share access privately; passwords are not included in CSV exports.</p></div><a asp-route="AdminUserTemplate" class="event-secondary mt-4">Download template</a>
            @if (!ViewData.ModelState.IsValid && Model.Open == "import") { <div asp-validation-summary="All" role="alert" class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800"></div> }
            @if (Model.ImportReport is { } report) { <section aria-label="Import result" class="mt-5 rounded-lg border border-campus-line p-4"><h3 class="text-sm font-bold">@report.Created created · @report.Errors.Count errors</h3>@if (report.Errors.Count > 0) { <ul class="mt-3 space-y-2 text-sm text-red-800">@foreach (var row in report.Errors) { <li>Row @row.Row: @row.Message</li> }</ul> }</section> }
            <div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-campus-line pt-4"><button type="button" data-close-user-dialog class="event-secondary">Close</button><button type="submit" class="event-primary">Import roster</button></div>
        </form></dialog>
