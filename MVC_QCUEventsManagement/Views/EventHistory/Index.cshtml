@using System.Globalization
@using MVC_QCUEventsManagement.ViewModels.Admin
@model EventHistoryViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Events History";
    ViewData["AdminSection"] = "History";
    var focus = "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-campus-focus";
    const string columns = "lg:grid-cols-[7rem_minmax(0,1.2fr)_minmax(0,1fr)_4rem]";
    var filtered = Model.Search.Length > 0 || Model.AcademicYear is not null || Model.Outcome is not null;
    (string Label, string? Outcome, int Count)[] filters =
    [
        ("All history", null, Model.TotalHistorical),
        ("Completed", "Completed", Model.Counts.GetValueOrDefault("Completed")),
        ("Cancelled", "Cancelled", Model.Counts.GetValueOrDefault("Cancelled"))
    ];
    string YearLabel(int year) => $"{year.ToString(CultureInfo.InvariantCulture)}–{(year + 1).ToString(CultureInfo.InvariantCulture)}";
}
<main class="w-full px-4 pt-6 pb-8 sm:px-6 sm:pt-7 lg:px-8">
    <header>
        <h1 class="text-2xl leading-tight font-extrabold tracking-tight text-campus-navy sm:text-[1.75rem]">Events History</h1>
        <p class="mt-1.5 max-w-prose text-sm text-campus-muted">Review completed and cancelled campus events.</p>
    </header>
    <section aria-label="Historical event results" class="mt-6 overflow-hidden rounded-xl border border-campus-line bg-white">
        <nav aria-label="Filter by event outcome" class="flex flex-wrap gap-x-5 border-b border-campus-line px-4 sm:gap-x-6">
            @foreach (var filter in filters)
            {
                var current = Model.Outcome == filter.Outcome;
                <a asp-route="AdminEventHistory" asp-route-q="@Model.Search" asp-route-year="@Model.AcademicYear" asp-route-outcome="@filter.Outcome" aria-current="@(current ? "page" : null)"
                   class="@focus -mb-px inline-flex min-h-12 items-center gap-1.5 border-b-2 text-xs font-semibold sm:text-sm @(current ? "border-campus-action text-campus-action" : "border-transparent text-campus-muted hover:text-campus-ink")">
                    @filter.Label <span class="rounded-md bg-campus-input px-1.5 py-0.5 text-xs tabular-nums">@filter.Count</span>
                </a>
            }
        </nav>
        <form asp-route="AdminEventHistory" method="get" role="search" class="grid items-end gap-3 p-4 sm:grid-cols-[minmax(0,1fr)_12rem] xl:grid-cols-[minmax(0,1fr)_12rem_auto]">
            @if (Model.Outcome is not null) { <input name="outcome" type="hidden" value="@Model.Outcome" /> }
            <div class="min-w-0">
                <label for="history-search" class="event-label">Search events</label>
                <input id="history-search" name="q" value="@Model.Search" type="search" maxlength="150" placeholder="Title, venue or college" class="@focus event-input" />
            </div>
            <div class="min-w-0">
                <label for="history-year" class="event-label">Academic year</label>
                <select id="history-year" name="year" class="@focus event-input">
                    <option value="">All academic years</option>
                    @if (Model.AcademicYear is { } selected && !Model.AcademicYears.Contains(selected)) { <option value="@selected" selected>@YearLabel(selected)</option> }
                    @foreach (var year in Model.AcademicYears) { <option value="@year" selected="@(Model.AcademicYear == year)">@YearLabel(year)</option> }
                </select>
            </div>
            <div class="flex flex-wrap gap-3 sm:col-span-2 xl:col-span-1"><button type="submit" class="@focus event-primary">Search</button><a asp-route="AdminEventHistory" class="@focus event-secondary">Reset filters</a></div>
        </form>
        @if (Model.Events.Count == 0)
        {
            <div class="border-t border-campus-line px-4 py-12 text-center">
                <h2 class="text-base font-bold text-campus-navy">@(filtered ? "No matching events" : "No event history yet")</h2>
                <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-campus-muted">@(filtered ? "Try another search, academic year or outcome, or reset your filters." : "Completed and cancelled events will appear here. Upcoming events stay in the Event Directory.")</p>
                @if (filtered) { <a asp-route="AdminEventHistory" class="@focus mt-4 inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-campus-action hover:underline">Clear filters</a> }
            </div>
        }
        else
        {
            <div aria-hidden="true" class="@columns hidden items-center gap-x-5 border-y border-campus-line bg-campus-input px-4 py-3 text-[11px] font-semibold tracking-wide text-campus-muted uppercase lg:grid">
                <span>Outcome</span><span>Event title & scope</span><span>Venue & date</span><span class="text-right">Actions</span>
            </div>
            <ul role="list" class="divide-y divide-campus-line">
                @foreach (var item in Model.Events)
                {
                    var statusClass = item.Outcome == "Cancelled" ? "bg-red-50 text-red-800" : "bg-emerald-50 text-emerald-800";
                    <li class="@columns grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-5 gap-y-3 px-4 py-5 text-sm lg:items-center">
                        <div class="col-span-2 lg:col-span-1"><span class="@statusClass inline-flex rounded-full px-2.5 py-1 text-xs font-semibold">@item.Outcome</span></div>
                        <div class="col-start-1 min-w-0 lg:col-start-auto">
                            <h2 class="text-sm leading-6 font-semibold wrap-break-word text-campus-navy"><a asp-route="AdminEventDetails" asp-route-id="@item.EventId" asp-route-from="history" aria-label="View details for @item.Title" class="@focus rounded-sm hover:text-campus-action hover:underline">@item.Title</a></h2>
                            <p class="mt-1 text-xs leading-5 wrap-break-word text-campus-muted">@(string.IsNullOrWhiteSpace(item.College) ? "Open to all colleges" : item.College)</p>
                        </div>
                        <div class="col-start-1 min-w-0 lg:col-start-auto">
                            <span class="mb-1 block text-xs text-campus-muted lg:sr-only">Venue & date</span>
                            <p class="text-[13px] leading-6 font-semibold wrap-break-word">@item.Venue</p>
                            <time datetime="@item.StartsAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="mt-0.5 block text-[13px] leading-5 font-medium tabular-nums text-campus-muted">@item.StartsAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</time>
                        </div>
                        <div class="col-start-2 row-start-2 row-end-4 self-end lg:col-start-auto lg:row-auto lg:self-auto lg:text-right">
                            <button type="button" disabled aria-label="View report for @item.Title (not implemented)" title="Analytics is not implemented yet" class="event-secondary min-w-16 cursor-not-allowed text-campus-muted opacity-65">View</button>
                        </div>
                    </li>
                }
            </ul>
        }
        @if (Model.Total > 0)
        {
            <nav aria-label="History pages" class="flex flex-wrap items-center justify-between gap-3 border-t border-campus-line px-4 py-3 text-xs text-campus-muted">
                <span>@((Model.Page - 1) * 25 + 1)–@((Model.Page - 1) * 25 + Model.Events.Count) of @Model.Total events</span>
                <div class="flex flex-wrap gap-2">
                    @if (Model.Page > 1) { <a asp-route="AdminEventHistory" asp-route-q="@Model.Search" asp-route-year="@Model.AcademicYear" asp-route-outcome="@Model.Outcome" asp-route-page="@(Model.Page - 1)" class="@focus event-secondary">Previous</a> }
                    else { <button type="button" disabled class="event-secondary cursor-not-allowed opacity-65">Previous</button> }
                    @if (Model.Page < Model.TotalPages) { <a asp-route="AdminEventHistory" asp-route-q="@Model.Search" asp-route-year="@Model.AcademicYear" asp-route-outcome="@Model.Outcome" asp-route-page="@(Model.Page + 1)" class="@focus event-secondary">Next</a> }
                    else { <button type="button" disabled class="event-secondary cursor-not-allowed opacity-65">Next</button> }
                </div>
            </nav>
        }
    </section>
</main>
