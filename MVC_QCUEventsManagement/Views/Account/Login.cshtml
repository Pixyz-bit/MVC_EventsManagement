@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Sign in";
}

<main class="grid min-h-dvh lg:grid-cols-[1.1fr_1fr]">
    <div class="relative m-4 mr-0 hidden overflow-hidden rounded-3xl bg-campus-navy lg:block" aria-hidden="true">
        <img src="~/images/qcu-campus.png" alt="" width="1920" height="1080"
             class="absolute inset-0 size-full object-cover object-center" />
    </div>

    <div class="flex min-w-0 flex-col px-6 py-7 sm:px-10 sm:py-9 xl:px-16">
        <div class="flex items-center gap-3.5">
            <img src="~/images/qcu-logo.png" alt="" width="48" height="48" class="size-11 shrink-0 object-contain" />
            <div>
                <p class="text-sm font-bold">Quezon City University</p>
                <p class="mt-0.5 text-sm text-campus-muted">Events Management</p>
            </div>
        </div>

        <section aria-labelledby="login-title" class="mx-auto w-full max-w-sm py-12 sm:py-16 lg:my-auto">
            <div class="mb-8">
                <h1 id="login-title" class="text-3xl font-extrabold tracking-tight sm:text-4xl">Sign in</h1>
                <p class="mt-3 text-sm leading-6 text-campus-muted">Use your QCU account to access the events portal.</p>
            </div>

            <form method="post" aria-describedby="login-status" class="space-y-5">
                <div>
                    <label for="identifier" class="block text-sm font-semibold">Student ID or email</label>
                    <input id="identifier" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" class="login-field" />
                </div>
                <div>
                    <label for="password" class="block text-sm font-semibold">Password</label>
                    <input id="password" type="password" autocomplete="current-password" class="login-field" />
                </div>
                <button type="submit" disabled class="min-h-12 w-full rounded-lg bg-campus-navy px-4 py-3 text-sm font-bold text-campus-surface disabled:cursor-not-allowed">
                    Sign in
                </button>
                <p id="login-status" class="text-sm leading-6 text-campus-muted">Sign-in is unavailable in this preview.</p>
            </form>
        </section>
    </div>
</main>
