@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Sign in";
}

<main class="grid min-h-dvh">
    <div class="relative isolate grid overflow-hidden bg-white lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div class="pointer-events-none absolute inset-y-0 right-0 -z-10 hidden w-[55%] lg:block" aria-hidden="true">
            <img src="~/images/qcu-campus.png" alt="" width="1920" height="1080"
                 class="absolute inset-0 size-full object-cover object-center" />
            <div class="absolute inset-0 bg-linear-to-r from-white from-3% via-white/35 via-34% to-white/0 to-78%"></div>
        </div>

        <div class="flex min-w-0 flex-col px-6 py-7 sm:px-10 sm:py-9 lg:pl-14 lg:pr-5 xl:pl-18">
            <div class="flex items-center gap-3.5">
                <img src="~/images/qcu-logo.png" alt="" width="48" height="48" class="size-11 shrink-0 object-contain" />
                <div>
                    <p class="text-sm font-bold">Quezon City University</p>
                    <p class="mt-0.5 text-sm text-campus-muted">Events Management</p>
                </div>
            </div>

            <section aria-labelledby="login-title" class="mx-auto w-full max-w-100 py-12 sm:py-16 lg:mx-0 lg:my-auto">
                <div class="mb-8">
                    <h1 id="login-title" class="text-4xl font-extrabold tracking-tight sm:text-5xl">Sign in</h1>
                    <p class="mt-3 text-sm leading-6 text-campus-muted">Use your QCU account to access the events portal.</p>
                </div>

                <form method="post" aria-describedby="login-status" class="space-y-5">
                    <div>
                        <label for="identifier" class="block text-sm font-semibold">Student ID or email</label>
                        <input id="identifier" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" class="login-field" />
                    </div>
                    <div>
                        <label for="password" class="block text-sm font-semibold">Password</label>
                        <div class="relative mt-2">
                            <input id="password" type="password" autocomplete="current-password" class="login-field mt-0 pr-20" />
                            <button id="password-visibility" type="button" hidden aria-controls="password"
                                    aria-label="Show password" class="absolute inset-y-0 right-1 min-w-15 rounded-lg px-2 text-sm font-bold text-campus-action focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-campus-focus">Show</button>
                        </div>
                    </div>
                    <button type="submit" disabled class="min-h-12 w-full rounded-full bg-campus-action px-4 py-3 text-sm font-bold text-white disabled:cursor-not-allowed">
                        Sign in
                    </button>
                    <p id="login-status" class="text-sm leading-6 text-campus-muted">Sign-in is unavailable in this preview.</p>
                </form>
            </section>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/account/login.js" asp-append-version="true" defer></script>
}
