@using MVC_QCUEventsManagement.ViewModels.Student
 @model StudentDashboardViewModel
 @{
     Layout = "_StudentLayout";
     ViewData["Title"] = "University Event Portal";
     ViewData["StudentStyle"] = "dashboard";
    ViewData["StudentEmail"] = Model.Email;
     var featured = Model.Available.Where(e => e.Status is "Open" or "Opens soon").Take(4).ToList();
     var registered = Context.Request.Query["view"] == "registered";
     var fallbackDescription = "Discover event agenda, network with university partners, and confirm your attendance pass.";
     ViewData["StudentBody"] = featured.Count == 0 ? "user-dashboard has-no-hero" : "user-dashboard";
     string? Banner(StudentDashboardEvent item) => item.HasBanner
         ? Url.RouteUrl("StudentEventBanner", new { id = item.Id })
         : Url.Content(item.BannerFallback);
 }
 <partial name="_StudentNavbar" model="new StudentIdentity(Model.DisplayName, Model.StudentId)" />
 @if (featured.Count > 0)
 {
     <section class="hero-showcase-container" id="heroGallery">
    <!-- Background Image Layer & Dark Vignette Overlay -->
    <div class="hero-bg-layer" id="heroBgImage" style="background-image:url('@Banner(featured[0])')"></div>
    <div class="hero-overlay-layer"></div>

    <!-- Main Hero Headline & Metadata -->
    <div class="hero-body-content" id="heroBodyContent" aria-live="polite">
        <h1 class="hero-title" id="heroTitle">@featured[0].Title</h1>
        <p class="hero-description" id="heroDescription">@(featured[0].Description ?? fallbackDescription)</p>

        <div class="hero-meta-list">
            <div class="hero-meta-item">
                <svg class="hero-meta-icon" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span id="heroVenue">@featured[0].Venue</span>
            </div>

            <div class="hero-meta-item">
                <svg class="hero-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                    <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" stroke-width="2.8"></path>
                </svg>
                <span id="heroDate">@featured[0].Start.ToString("MMM d, yyyy")</span>
            </div>

            <div class="hero-meta-item">
                <svg class="hero-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 12"></polyline>
                </svg>
                <span id="heroTime">@featured[0].TimeRange</span>
            </div>
        </div>

        <div style="margin-top:1.5rem; display:flex; align-items:center; gap:1rem;">
            <a id="heroActionBtn" href="@Url.RouteUrl("StudentEventRegistration", new { id = featured[0].Id })" class="btn-hero-action">
                <span>VIEW EVENT &amp; REGISTER</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </div>

    <!-- Hero Carousel Bottom Bar Controls -->
    <div class="hero-carousel-controls">
        <div class="hero-carousel-dots" id="heroCarouselDots">
                @for (var slide = 0; slide < featured.Count; slide++)
                {
                            <button type="button" class="hero-dot-btn @(slide == 0 ? "active" : "")" data-slide="@slide" aria-label="Featured event @(slide + 1)" aria-pressed="@(slide == 0 ? "true" : "false")"></button>
                }
            </div>
        <div class="hero-carousel-nav-arrows">
            <button type="button" class="hero-arrow-btn" data-slide-step="-1" aria-label="Previous Slide">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <button type="button" class="hero-arrow-btn" data-slide-step="1" aria-label="Next Slide">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
        </div>
    </div>
</section>
     <div id="featuredEvents" hidden>
         @foreach (var item in featured)
         {
             <span data-card="card-@item.Id"></span>
         }
     </div>
 }
 <main class="portal-main">
     @if (TempData["StudentMessage"] is string message) { <p role="status" class="toast-banner toast-success">@message</p> }
     @if (TempData["StudentError"] is string error) { <p role="alert" class="toast-banner toast-error">@error</p> }
     <section class="events-view-section" id="events-section">
         <div class="section-header-row">
             <div class="section-title-block">
                <h2 id="viewSectionTitle">@(registered ? "My Registered Events & Passes" : "Campus Events")</h2>
                <p id="viewSectionSubtitle">@(registered ? "Inspect your enrolled passes and verified event schedules." : "Explore open registrations or inspect your booked electronic passes.")</p>
             </div>
             <div class="tab-toggle-container" role="group" aria-label="Event views">
                 <button type="button" class="tab-btn @(!registered ? "active" : "")" data-event-tab="catalog" aria-controls="catalogContentArea" aria-pressed="@(!registered ? "true" : "false")"><span>Available Events</span></button>
                 <button type="button" class="tab-btn @(registered ? "active" : "")" data-event-tab="registered" aria-controls="registeredContentArea" aria-pressed="@(registered ? "true" : "false")"><span>My Registered Events</span></button>
             </div>
         </div>
         <div class="events-catalog-content" id="catalogContentArea" hidden="@registered">
             @if (Model.Available.Count == 0)
             {
                 <div class="empty-passes-box">
                     <h3>No eligible events available</h3>
                     <p>@(Model.StudentId is null ? "Your student profile is missing. Contact an administrator to complete it." : "Return later for events open to your campus and academic group.")</p>
                 </div>
             }
             <div class="events-grid" id="eventsGridContainer">
                 @foreach (var item in Model.Available) { <partial name="_DashboardEvent" model="item" /> }
             </div>
         </div>
        <div class="registered-section-content @(registered ? "active-view" : "")" id="registeredContentArea" hidden="@(!registered)">
             <div class="events-grid registered-cards-grid">
                 @foreach (var item in Model.Registered) { <partial name="_DashboardEvent" model="item" /> }
             </div>
             @if (Model.Registered.Count == 0)
             {
                 <div class="empty-passes-box">
                     <h4>No Active Event Registrations</h4>
                     <p>You have not booked electronic passes for any upcoming campus events yet. Explore open events above to register.</p>
                     <button type="button" class="btn-view-details" data-browse-events>BROWSE OPEN EVENTS &rarr;</button>
                 </div>
             }
         </div>
     </section>
 </main>
 <partial name="_DashboardDialogs" />
 @section Scripts { <script src="~/js/student/student-dashboard.js" asp-append-version="true" defer></script> }
