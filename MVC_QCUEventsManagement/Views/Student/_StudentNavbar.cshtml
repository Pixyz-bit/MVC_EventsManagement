@model MVC_QCUEventsManagement.ViewModels.Student.StudentIdentity
@switch (ViewData["StudentStyle"] as string)
{
    case "dashboard":
<header class="portal-navbar" id="portalNavbar">
    <div class="navbar-inner">
        <a href="@Url.RouteUrl("StudentDashboard")" class="nav-brand">
            <img src="~/images/qcu-logo.png" alt="University Emblem" class="nav-logo-img" />
            <div>
                <div class="nav-brand-title">University Event Portal</div>
                <div class="nav-brand-subtitle">Quezon City University</div>
            </div>
        </a>

        <div class="nav-user-bar">
            <a href="@(Model.Id is null ? Url.RouteUrl("StudentDashboard") : Url.RouteUrl("StudentProfile"))" class="nav-user-badge" title="Manage Account Settings" data-email="@ViewData["StudentEmail"]" style="text-decoration:none; color:inherit; cursor:pointer;">
                <div class="nav-user-avatar">
                    @Model.Initials
                </div>
                <div class="nav-user-info">
                    <span class="nav-user-name">@Model.Name</span>
                    <span class="nav-user-id">[ @Model.Id ]</span>
                </div>
            </a>

            <button type="button" class="nav-btn-signout" id="openLogout" title="Sign Out" aria-label="Log out" aria-haspopup="dialog">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </button>
        </div>
    </div>
</header>
<dialog id="logoutConfirmDialog" class="logout-confirm-dialog" aria-labelledby="logoutConfirmTitle" aria-describedby="logoutConfirmDescription">
    <h2 id="logoutConfirmTitle">Log out?</h2>
    <p id="logoutConfirmDescription">You’ll need to sign in again to access your account.</p>
    <form class="logout-confirm-actions" asp-controller="Account" asp-action="Logout" method="post">
        <button id="logoutStayButton" type="button" class="logout-stay-button">Stay signed in</button>
        <button type="submit" class="logout-confirm-button">Log out</button>
    </form>
</dialog>
        break;
    case "event-registration":
<header class="portal-navbar">
    <div class="navbar-inner">
        <a href="@Url.RouteUrl("StudentDashboard")" class="nav-brand">
            <img src="~/images/qcu-logo.png" alt="University Emblem" class="nav-logo-img" />
            <div>
                <div class="nav-brand-title">University Event Portal</div>
                <div class="nav-brand-subtitle">Quezon City University</div>
            </div>
        </a>

        <div class="nav-user-bar">
            <a href="@Url.RouteUrl("StudentProfile")" class="nav-user-badge" aria-label="Account settings" style="text-decoration:none; color:inherit;">
                <div class="nav-user-avatar">
                    @Model.Initials
                </div>
                <div class="nav-user-info">
                    <span class="nav-user-name">@Model.Name</span>
                    <span class="nav-user-id">[ @Model.Id ]</span>
                </div>
            </a>

            <a href="@Url.RouteUrl("StudentDashboard")" class="nav-link-back" title="Return to Dashboard" aria-label="Cancel and return to dashboard">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Cancel &amp; Return</span>
            </a>
        </div>
    </div>
</header>
        break;
    case "event-pass":
<header class="portal-navbar">
    <div class="navbar-inner">
        <a href="@Url.RouteUrl("StudentDashboard")" class="nav-brand">
            <img src="~/images/qcu-logo.png" alt="University Emblem" class="nav-logo-img" />
            <div>
                <div class="nav-brand-title">University Event Portal</div>
                <div class="nav-brand-subtitle">Quezon City University</div>
            </div>
        </a>

        <a href="@Url.RouteUrl("StudentDashboard")" class="nav-link-dashboard" aria-label="My Dashboard">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>My Dashboard</span>
        </a>
    </div>
</header>
        break;
    default:
<header class="portal-navbar">
    <div class="navbar-inner">
        <a href="@Url.RouteUrl("StudentDashboard")" class="nav-brand">
            <img src="~/images/qcu-logo.png" alt="University Emblem" class="nav-logo-img" />
            <div>
                <div class="nav-brand-title">University Event Portal</div>
                <div class="nav-brand-subtitle">Quezon City University</div>
            </div>
        </a>

        <div class="nav-user-bar">
            <div class="nav-user-badge">
                <div class="nav-user-avatar">
                    @Model.Initials
                </div>
                <div class="nav-user-info">
                    <span class="nav-user-name">@Model.Name</span>
                    <span class="nav-user-id">[ @Model.Id ]</span>
                </div>
            </div>

            <a href="@Url.RouteUrl("StudentDashboard")" class="nav-link-back" title="Return to Dashboard" aria-label="Return to dashboard">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Dashboard</span>
            </a>
        </div>
    </div>
</header>
        break;
}
