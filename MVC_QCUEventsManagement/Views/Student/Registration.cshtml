@using MVC_QCUEventsManagement.ViewModels.Student
@model StudentBookingViewModel?
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Event Registration";
    ViewData["StudentStyle"] = "event-registration";
    ViewData["StudentBody"] = "user-registration";
    var identity = Model?.Profile.Identity ?? new StudentIdentity("Student", null);
    var input = ViewData["BookingInput"] as StudentBookingInput ?? new();
    string[] years = ["1st Year", "2nd Year", "3rd Year", "4th Year", "Irregular"];
}
<partial name="_StudentNavbar" model="identity" />
<main class="registration-container">
    <!-- Breadcrumbs Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
            <li class="breadcrumb-item">
                <a href="@Url.RouteUrl("StudentDashboard")">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="breadcrumb-separator">/</li>
            <li class="breadcrumb-item">
                <a href="@Url.RouteUrl("StudentDashboard")#events-section">
                    <span>Campus Events</span>
                </a>
            </li>
            <li class="breadcrumb-separator">/</li>
            <li class="breadcrumb-item active" aria-current="page">
                <span>Event Registration</span>
            </li>
        </ol>
    </nav>

    <!-- Page Title Block -->
    <div class="page-header-row">
        <h2>Campus Event Registration</h2>
        <div>
            @if (Model?.Event.SeatsAvailable is int seats)
            {
                <span class="context-tag @(seats == 0 ? "fully-booked" : "spots-left")">@(seats == 0 ? "FULLY BOOKED" : $"{seats} SPOTS LEFT")</span>
            }
        </div>
    </div>

    <!-- Error Banner (if any) -->
    @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-alert-banner" role="alert" asp-validation-summary="All"></div>
        }

    @if (Model is null || Model.Event.Status != "Open")
        {
            <div class="event-summary-card" role="status">
        <h3 class="event-summary-title">Registration unavailable</h3>
        @if (Model is not null) { <p>@Model.Event.Title</p> }
        <p>@(Model?.Event.Status == "Opens soon" ? $"Registration opens {Model.Event.RegStart:MMM d, yyyy}." : "Registration is unavailable for this event.")</p>
        <a href="@Url.RouteUrl("StudentDashboard")#events-section" class="btn-secondary">Back to Campus Events</a>
    </div>
        }
        else
        {
            var ev = Model.Event;
            var profile = Model.Profile;
            var banner = ev.HasBanner ? Url.RouteUrl("StudentEventBanner", new { id = ev.Id }) : null;


    <!-- Event Context Summary Card -->
    <div class="event-summary-card">
        <!-- Topmost Event Promotional Banner Poster -->
        @if (banner is not null)
                {
                    <div class="event-summary-banner-hero">
            <img src="@banner" alt="" class="event-summary-banner-img" />
            <div class="event-summary-banner-gradient"></div>
            <div class="event-summary-banner-tag">
                <span class="banner-tag-pulse"></span>
                <span>FEATURED CAMPUS EVENT</span>
            </div>
        </div>
                }

        <!-- Structured Event Details Body -->
        <div class="event-summary-content">
            <div class="event-summary-header">
                <div class="event-summary-title-col">
                    <div class="event-summary-eyebrow">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="8.5" cy="7" r="4"></circle>
                            <polyline points="17 11 19 13 23 9"></polyline>
                        </svg>
                        <span>REGISTERING FOR:</span>
                    </div>
                    <h3 class="event-summary-title">
                        @ev.Title
                    </h3>
                    <p class="event-summary-desc">
                        @ev.Description
                    </p>
                </div>
            </div>

            <div class="event-summary-meta-grid">
                <div class="meta-chip">
                    <div class="meta-chip-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <div class="meta-chip-content">
                        <span class="meta-chip-label">DATE &amp; TIME</span>
                        <span class="meta-chip-val meta-chip-val-stacked">
                            <span>@($"{ev.Start:MMMM d, yyyy}")</span>
                            <span>@ev.TimeRange</span>
                        </span>
                    </div>
                </div>

                <div class="meta-chip">
                    <div class="meta-chip-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <div class="meta-chip-content">
                        <span class="meta-chip-label">VENUE LOCATION</span>
                        <span class="meta-chip-val">@ev.Venue</span>
                    </div>
                </div>

                <div class="meta-chip">
                    <div class="meta-chip-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                    </div>
                    <div class="meta-chip-content">
                        <span class="meta-chip-label">LIVE CAPACITY</span>
                        <span class="meta-chip-val">@ev.SeatsAvailable seats remaining</span>
                    </div>
                </div>
            </div>


        </div>
    </div>

    <!-- Main Form Card: View-Only Student Info + Interactive Year & Section Inputs -->
    <form asp-action="Book" asp-route-id="@ev.Id" method="post" class="registration-form-card">
        <!-- Section Header -->
        <div class="card-section-header">
            <div class="section-title-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span class="section-title">Student Profile &amp; Enrollment Information</span>
            </div>
            <span class="section-badge-locked">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:inline-block; vertical-align:middle; margin-right:3px;">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                OFFICIAL RECORD
            </span>
        </div>

        <!-- Section Body -->
        <div class="card-section-body">
            <!-- 1. VIEW-ONLY STUDENT DETAILS -->
            <p class="section-desc-note">
                Your electronic event pass and attendance QR ticket will be verified against your official matriculation record below:
            </p>

            <div class="viewonly-student-grid">
                <!-- Student ID -->
                <div class="viewonly-item">
                    <span class="viewonly-label">
                        <span>Student ID Number</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <span class="viewonly-value highlight-id">
                        @profile.Identity.Id
                    </span>
                </div>

                <!-- Full Name -->
                <div class="viewonly-item">
                    <span class="viewonly-label">
                        <span>Full Student Name</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <span class="viewonly-value">
                        @profile.Identity.Name
                    </span>
                </div>

                <!-- University Email -->
                <div class="viewonly-item">
                    <span class="viewonly-label">
                        <span>Institutional Email</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <span class="viewonly-value">
                        @profile.Email
                    </span>
                </div>

                <!-- Campus Branch -->
                <div class="viewonly-item">
                    <span class="viewonly-label">
                        <span>Campus Branch</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <span class="viewonly-value">
                        @profile.Campus
                    </span>
                </div>

                <!-- College / Department -->
                <div class="viewonly-item">
                    <span class="viewonly-label">
                        <span>College / Department</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <span class="viewonly-value">
                        @profile.Department
                    </span>
                </div>

                <!-- Degree Program -->
                <div class="viewonly-item">
                    <span class="viewonly-label">
                        <span>Degree Program</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </span>
                    <span class="viewonly-value">
                        @profile.Program
                    </span>
                </div>
            </div>

            <!-- 2. INTERACTIVE COHORT INPUTS: YEAR AND SECTION -->
            <div class="inputs-subheading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 11 12 14 22 4"></polyline>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
                <span>Please Specify Your Current Standing &amp; Section</span>
            </div>

            <div class="inputs-grid-2col">
                <!-- Year Level Input -->
                <div class="form-group">
                    <label class="form-label" for="Year">
                        <span>Current Year Level <span class="req">*</span></span>
                        <span class="form-label-muted">Select Academic Year</span>
                    </label>
                    <select id="Year" name="Year" class="form-select" required>
                                <option value="">Select your current year</option>
                                @for (var year = 1; year <= years.Length; year++)
                                {
                                    <option value="@year" selected="@(input.Year == year)">@years[year - 1]</option>
                                }
                            </select>
                    @if (Model.TargetYear is int requiredYear) { <p>Open to @years[requiredYear - 1] students.</p> }
                </div>

                <!-- Class Section Input -->
                <div class="form-group">
                    <label class="form-label" for="Section">
                        <span>Class Section <span class="req">*</span></span>
                        <span class="form-label-muted">e.g. SBIT-3A, SBIT-3C</span>
                    </label>
                    <input name="Section" id="Section" class="form-input" maxlength="50" placeholder="e.g. SBIT-3C" value="@input.Section" required />
                </div>
            </div>

            <!-- 3. COMMITMENT & GUIDELINES CONFIRMATION -->
            <div class="commitment-card">
                <label class="commitment-checkbox-label" for="Terms">
                    <input name="Terms" id="Terms" type="checkbox" value="true" checked="@input.Terms" required />
                    <span>I confirm that I will attend this event and agree to follow all official university event guidelines and campus health/safety protocols.</span>
                </label>
                <p class="commitment-subtext">
                    Note: Reserved seats that result in unexcused absences will be audited as No-Shows in accordance with the campus extracurricular attendance charter.
                </p>
            </div>

            <!-- 4. ACTION BUTTONS -->
            <div class="form-actions-footer">
                <a href="@Url.RouteUrl("StudentDashboard")" class="btn-secondary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Back to Events Dashboard</span>
                </a>

                <button type="submit" class="btn-primary-confirm">Confirm Registration</button>
            </div>
        </div>
    </form>
        }
</main>
